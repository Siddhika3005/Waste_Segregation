# ============================================
# Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# FastAPI Server Configuration
# ============================================
# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# Server port
API_PORT=8080

# Environment: development, production, testing
ENVIRONMENT=development

# Enable reload on file changes (development only)
RELOAD=true

# Enable debug mode
DEBUG=true

# ============================================
# Model Configuration
# ============================================
# Path to trained model (relative to backend folder)
MODEL_PATH=waste_model.h5

# Alternative TFLite model path
TFLITE_MODEL_PATH=waste_model.tflite

# Image size for model input
IMG_SIZE=224

# ============================================
# Dataset Configuration
# ============================================
# Path to dataset folder (for training)
DATASET_DIR=dataset

# Training batch size
BATCH_SIZE=32

# Training epochs
EPOCHS=20

# Validation split ratio
VALIDATION_SPLIT=0.3

# ============================================
# GPU/Hardware Configuration
# ============================================
# Enable GPU (true/false)
USE_GPU=true

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=logs/app.log

# ============================================
# CORS Configuration
# ============================================
# Allowed origins (comma-separated)
ALLOWED_ORIGINS=*

# ============================================
# Performance Configuration
# ============================================
# Number of worker threads for preprocessing
NUM_WORKERS=4

# Maximum file upload size in MB
MAX_UPLOAD_SIZE=50

# Request timeout in seconds
REQUEST_TIMEOUT=300
